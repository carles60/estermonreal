---
// src/components/SliderSuperpuesto.astro
import { Image } from 'astro:assets';

// 1. Importamos las imágenes directamente desde src/assets/
import foto1 from '../assets/assets-infoarquitectura/habitatge-jardin-del-sol/js-01.jpg';
import foto2 from '../assets/assets-infoarquitectura/habitatge-jardin-del-sol/js-02.jpg';
import foto3 from '../assets/assets-infoarquitectura/habitatge-jardin-del-sol/js-03.jpg';
import foto4 from '../assets/assets-infoarquitectura/habitatge-jardin-del-sol/js-04.jpg';
import foto5 from '../assets/assets-infoarquitectura/habitatge-jardin-del-sol/js-10.jpg';

// 2. Definimos el array usando las imágenes importadas
const imagenes = [
  { src: foto1, alt: 'Jardín del Sol 01' },
  { src: foto2, alt: 'Jardín del Sol 02' },
  { src: foto3, alt: 'Jardín del Sol 03' },
  { src: foto4, alt: 'Jardín del Sol 04' },
  { src: foto5, alt: 'Jardín del Sol 05' },
];
---

<section class="seccion-slider">
  <div class="contenedor-slider">
    {imagenes.map((imagen, index) => (
      <div class={`diapositiva ${index === 0 ? 'activa' : ''}`} data-index={index}>
        {/* Usamos la etiqueta <Image /> optimizada de Astro */}
        <Image src={imagen.src} alt={imagen.alt} loading={index === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
  </div>
</section>

<script>
  function iniciarSlider() {
    const diapositivas = document.querySelectorAll('.diapositiva');
    if (diapositivas.length === 0) return;

    let indiceActual = 0;
    const totalDiapositivas = diapositivas.length;

    function cambiarDiapositiva() {
      diapositivas[indiceActual].classList.remove('activa');
      indiceActual = (indiceActual + 1) % totalDiapositivas;
      diapositivas[indiceActual].classList.add('activa');
    }

    setInterval(cambiarDiapositiva, 3000);
  }

  document.addEventListener('DOMContentLoaded', iniciarSlider);
</script>

<style>
  .seccion-slider {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 3rem 0;
    background-color: #f9fafb;
  }

  .contenedor-slider {
    width: 100%;
    max-width: 1140px; 
    height: 60vh;
    min-height: 400px;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background-color: #000; /* Fondo negro para que no parpadee en blanco durante el cambio */
  }

  /* Todas las imágenes empiezan totalmente transparentes */
  .diapositiva {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 1;
    /* Transición de 1.5 segundos solo para la opacidad */
    transition: opacity 1.5s ease-in-out;
  }

  /* La imagen activa se vuelve visible gradualmente */
  .diapositiva.activa {
    opacity: 1;
    z-index: 2;
  }

  /* Ajuste de la imagen */
  .diapositiva img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>