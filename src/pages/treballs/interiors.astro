---
// src/pages/treballs/infoarquitectura.astro
import Header from '../../components/Header.astro';
import { Image } from 'astro:assets';

// Importamos imágenes de muestra para los proyectos de Infoarquitectura
import foto1 from '../../assets/assets-interiors/redisseny-mercat-girona/mg-04.jpg';
import foto2 from '../../assets/assets-interiors/habitatge-carrer-jaume-I/hj-04.jpg';
import foto3 from '../../assets/assets-interiors/estudi-interiorisme-ems/ems-02.jpg';


// Listado de proyectos de la categoría Interiors
const projectes = [
  {
    titol: 'Redisseny del Mercat de Girona',
    slug: '/treballs/interiors/redisseny-mercat-girona',
    imatge: foto1,
    alt: 'Render: Redisseny del Mercat de Girona'
  },
  {
    titol: 'Habitatge al carrer Jaume I',
    slug: '/treballs/interiors/habitatge-carrer-jaume-I',
    imatge: foto2,
    alt: 'Render: Projecte interiors'
  },
  {
    titol: "Estudi d'interiorisme EMS",
    slug: '/treballs/interiors/estudi-interiorisme-ems',
    imatge: foto3,
    alt: 'Render: Estudi interiors EMS"'
  },
    
];
---

<!DOCTYPE html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interiors | Ester Monreal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body>

    <Header />

    <main class="contenedor-categoria">
      <!-- Enlace para volver a la lista general de categorías -->
      <nav class="migas-pan">
        <a href="/treballs">← Tornar a Treballs</a>
      </nav>

      <h1 class="titulo-categoria">INTERIORS</h1>
      
      <!-- Retícula de proyectos -->
      <div class="grid-projectes">
        {projectes.map((projecte) => (
          <a href={projecte.slug} class="tarjeta-projecte">
            <div class="contenedor-imagen">
              <Image src={projecte.imatge} alt={projecte.alt} />
            </div>
            <div class="info-projecte">
              <h2>{projecte.titol}</h2>
            </div>
          </a>
        ))}
      </div>
    </main>

  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Montserrat', sans-serif;
    color: #111;
    background-color: #fff;
  }
</style>

<style>
  .contenedor-categoria {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .migas-pan {
    margin-bottom: 2rem;
  }

  .migas-pan a {
    color: #777;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 1px;
    transition: color 0.2s ease;
  }

  .migas-pan a:hover {
    color: #000;
  }

  .titulo-categoria {
    text-align: center;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 3px;
    margin-bottom: 3rem;
  }

  /* Retícula de 2 columnas para un diseño amplio de arquitectura */
  .grid-projectes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
  }

  /* En pantallas pequeñas pasa a 1 sola columna */
  @media (max-width: 768px) {
    .grid-projectes {
      grid-template-columns: 1fr;
    }
  }

  .tarjeta-projecte {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .contenedor-imagen {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 4px;
    background-color: #f4f4f4;
  }

  .contenedor-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .info-projecte {
    padding-top: 1rem;
  }

  .info-projecte h2 {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 1px;
    color: #222;
    transition: color 0.2s ease;
  }

  /* Efecto Hover: sutil zoom a la foto y cambio de tono en el título */
  .tarjeta-projecte:hover .contenedor-imagen img {
    transform: scale(1.03);
  }

  .tarjeta-projecte:hover .info-projecte h2 {
    color: #777;
  }
</style>