---
// src/pages/contacto.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contacte | Ester Monreal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body>

    <Header />

    <main class="contenedor-treballs">
      <h1 class="titulo-seccion">CONTACTE</h1>

      <div class="contenedor-formulario">
        <p class="descripcion">
          Si tens un projecte en ment, vols sol·licitar un pressupost o tens qualsevol dubte, pots omplir el següent formulari:
        </p>

        <form action="https://api.web3forms.com/submit" method="POST" class="form-contacto">
          <!-- TU CLAVE DE WEB3FORMS -->
          <input type="hidden" name="access_key" value="f9afbf1e-1e92-4f7f-9c1c-8ee14e681ef4" />

          <div class="campo">
            <label for="nombre">Nom i cognoms *</label>
            <input type="text" id="nombre" name="nombre" required placeholder="El teu nom" />
          </div>

          <div class="campo">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required placeholder="nom@exemple.com" />
          </div>

          <div class="campo">
            <label for="asunto">Assumpte</label>
            <input type="text" id="asunto" name="asunto" placeholder="Motiu de la consulta" />
          </div>

          <div class="campo">
            <label for="mensaje">Missatge *</label>
            <textarea id="mensaje" name="mensaje" rows="6" required placeholder="Escriu el teu missatge aquí..."></textarea>
          </div>
          <div class="form-group-checkbox">
            <input type="checkbox" id="politica" name="politica" required />
            <label for="politica">
              He llegit i accepto la <a href="/politica-privacitat" target="_blank" rel="noopener noreferrer">Política de Privacitat</a>
            </label>
          </div>

          <button type="submit" class="btn-enviar">Enviar missatge</button>
        </form>
      </div>
    </main>
    
  <!-- Resto del contenido -->
    <Footer />

  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Montserrat', sans-serif !important;
    color: #111;
    background-color: #fff;
    /* AÑADE ESTAS TRES LÍNEAS: */
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  
    /* ESTO HACE QUE EL CONTENIDO "EMPUJE" AL FOOTER ABAJO DEL TODO: */
    flex: 1; 
}
</style>

<style>
  .contenedor-treballs {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .titulo-seccion {
    text-align: center;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 3px;
    margin-bottom: 2.5rem;
  }

  /* Centramos el contenedor del formulario */
  .contenedor-formulario {
    max-width: 600px;
    margin: 0 auto;
  }

  .descripcion {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #444;
    margin-bottom: 2rem;
    text-align: center;
  }

  .form-contacto {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group-checkbox {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 15px;
  margin-bottom: 20px;
}

  .form-group-checkbox input[type="checkbox"] {
    cursor: pointer;
    width: 18px;
    height: 18px;
  }

  .form-group-checkbox label {
    font-size: 0.9rem;
    cursor: pointer;
  }

  .form-group-checkbox a {
    text-decoration: underline;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .campo label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
  }

  .campo input,
  .campo textarea {
    width: 100%;
    padding: 0.8rem;
    border: 1px solid #ddd;
    border-radius: 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    background-color: #fafafa;
  }

  .campo input:focus,
  .campo textarea:focus {
    outline: none;
    border-color: #111;
    background-color: #fff;
  }

  .btn-enviar {
    padding: 0.9rem 1.8rem;
    background-color: #111;
    color: #fff;
    border: none;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    align-self: center; /* Botón centrado */
    transition: background-color 0.2s;
  }

  .btn-enviar:hover {
    background-color: #333;
  }

  @media (max-width: 768px) {
    .btn-enviar {
      width: 100%;
    }
  }
</style>