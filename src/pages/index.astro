---
// src/pages/index.astro
import Header from '../components/Header.astro';
import SliderSuperpuesto from '../components/SliderSuperpuesto.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ester Monreal | Arquitectura Interior</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body>

    <Header />
    
    <SliderSuperpuesto />

    <!-- Sección de texto bajo el slider -->
    <main class="contenedor-subtitulo">
      <h1 class="texto-cabecera">
        ESTER MONREAL I SEBASTIÀ - ARQUITECTURA INTERIOR I INFOARQUITECTURA -
      </h1>
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Montserrat', sans-serif !important;
    color: #111;
    background-color: #fff;
    
    /* AÑADE ESTAS TRES LÍNEAS: */
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}
  main {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    
    /* ESTO HACE QUE EL CONTENIDO "EMPUJE" AL FOOTER ABAJO DEL TODO: */
    flex: 1; 
  }
  html, body {
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden; /* Elimina la franja blanca y el desplazamiento lateral */
}
</style>

<style>
  /* Estilos específicos para el texto principal */
  .contenedor-subtitulo {
    width: 100%;
    max-width: 1140px; /* Mismo ancho máximo que el slider */
    margin: 0 auto;    /* Centra el contenedor horizontalmente */
    padding: 3rem 1.5rem; /* Espaciado arriba/abajo y margen de seguridad a los lados */
    text-align: center;
  }

  .texto-cabecera {
    font-size: 0.95rem;      /* Tamaño sutil y elegante */
    font-weight: 500;        /* Peso medio */
    letter-spacing: 2px;     /* Separación entre letras para un look arquitectónico */
    color: #222222;          /* Gris muy oscuro, más suave que el negro puro */
    line-height: 1.6;        /* Altura de línea para que si envuelve en móvil se lea bien */
    text-transform: uppercase;
  }
</style>
