---
// src/pages/treballs.astro
import Header from '../components/Header.astro';
import { Image } from 'astro:assets';
import Footer from '../components/Footer.astro';

// Importamos las fotos representativas para las 3 categorías
import fotoInfoarquitectura from '/src/assets/assets-infoarquitectura/habitatge-jardin-del-sol/js-01.jpg';
import fotoInteriors from '/src/assets/assets-interiors/estudi-interiorisme-ems/ems-01.jpg';
import fotoEfimers from '/src/assets/assets-efimers/temps-de-flors-muntatge/tfm-01.jpg';

const categorias = [
  {
    titulo: 'Infoarquitectura',
    slug: '/treballs/infoarquitectura',
    imagen: fotoInfoarquitectura,
    alt: 'Categoría Infoarquitectura'
  },
  {
    titulo: 'Interiors',
    slug: '/treballs/interiors',
    imagen: fotoInteriors,
    alt: 'Categoría Interiors'
  },
  {
    titulo: 'Treballs efímers',
    slug: '/treballs/efimers',
    imagen: fotoEfimers,
    alt: 'Categoría Treballs efímers'
  }
];
---

<!DOCTYPE html>
<html lang="ca">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Treballs | Ester Monreal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  </head>
  <body>

    <Header />

    <main class="contenedor-treballs">
      <h1 class="titulo-seccion">TREBALLS</h1>
      
      <div class="grid-categorias">
        {categorias.map((cat) => (
          <a href={cat.slug} class="tarjeta-categoria">
            <div class="contenedor-imagen">
              <Image src={cat.imagen} alt={cat.alt} />
            </div>
            <div class="capa-titulo">
              <h2>{cat.titulo}</h2>
            </div>
          </a>
        ))}
      </div>
    </main>

    <Footer /> 

  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

   body {
    font-family: 'Montserrat', sans-serif !important;
    color: #111;
    background-color: #fff;
    /* AÑADE ESTAS TRES LÍNEAS: */
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  
    /* ESTO HACE QUE EL CONTENIDO "EMPUJE" AL FOOTER ABAJO DEL TODO: */
    flex: 1; 
}
</style>

<style>
  .contenedor-treballs {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .titulo-seccion {
    text-align: center;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 3px;
    margin-bottom: 3rem;
  }

  /* Grid de 3 columnas para las tarjetas */
  .grid-categorias {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  /* En pantallas móviles se verá en 1 sola columna */
  @media (max-width: 768px) {
    .grid-categorias {
      grid-template-columns: 1fr;
    }
  }

  /* Tarjeta individual */
  .tarjeta-categoria {
    display: block;
    position: relative;
    text-decoration: none;
    overflow: hidden;
    border-radius: 4px;
    aspect-ratio: 4 / 5; /* Mantiene una proporción vertical muy elegante */
  }

  .contenedor-imagen {
    width: 100%;
    height: 100%;
  }

  .contenedor-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  /* Capa oscura superpuesta con el título */
  .capa-titulo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.35);
    display: flex;
    justify-content: center;
    align-items: center;
    transition: background 0.3s ease;
  }

  .capa-titulo h2 {
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: center;
    padding: 0 1rem;
  }

  /* Efecto Hover sutil: zoom suave a la imagen y ligero oscurecimiento */
  .tarjeta-categoria:hover .contenedor-imagen img {
    transform: scale(1.05);
  }

  .tarjeta-categoria:hover .capa-titulo {
    background: rgba(0, 0, 0, 0.55);
  }
</style>